<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Task 6: nullable reference types are switched on for the whole project -->
    <Nullable>enable</Nullable>
    <RootNamespace>ExpenseTracker</RootNamespace>
    <AssemblyName>ExpenseTracker</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Lets the app run on a newer .NET runtime if only .NET 9/10 is installed -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The xUnit project lives in Tests/, inside this folder. Keep its files out of the app build. -->
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
